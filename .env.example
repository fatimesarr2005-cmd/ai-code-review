# Token GitHub avec droits: repo (lecture) + pull_requests (écriture)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Secret à définir dans les paramètres webhook GitHub
GITHUB_WEBHOOK_SECRET=change_me

# Modèle à utiliser (nom HuggingFace ou chemin local)
MODEL_NAME=microsoft/codereviewer

# Paramètres de génération (optionnels)
MAX_INPUT_LENGTH=512
MAX_NEW_TOKENS=96
NUM_BEAMS=4

# Serveur Flask (optionnels)
FLASK_PORT=5000
FLASK_DEBUG=false
